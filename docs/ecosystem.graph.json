        "Planner Agent",
        "Objective Clarifier Agent",
        "Intent Classifier Agent",
        "Decomposer Agent"
      ],
      "optional_agents": [
        "Reflection Agent",
        "Meta-Reasoner Agent",
        "Config Validation Agent"
      ],
      "depends_on": [],
      "tags": ["prompt", "structure", "planning", "intent", "clarify", "decompose"]
    },
