{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.agentics/session.json ]; then TMP=$(mktemp) && jq '.edits += 1' ~/.agentics/session.json > \"$TMP\" 2>/dev/null && mv \"$TMP\" ~/.agentics/session.json; fi; [ -d node_modules/claude-flow ] && [ -n \"$TOOL_INPUT_file_path\" ] && npx @claude-flow/cli@latest hooks pre-edit --file \"$TOOL_INPUT_file_path\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.agentics/session.json ]; then TMP=$(mktemp) && jq '.commands += 1' ~/.agentics/session.json > \"$TMP\" 2>/dev/null && mv \"$TMP\" ~/.agentics/session.json; fi; [ -d node_modules/claude-flow ] && [ -n \"$TOOL_INPUT_command\" ] && npx @claude-flow/cli@latest hooks pre-command --command \"$TOOL_INPUT_command\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "^Task$",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.agentics/agents && HASH=$(printf '%s' \"${TOOL_INPUT_prompt:-noid}\" | cksum | cut -d' ' -f1) && printf '{\"type\":\"%s\",\"prompt_snippet\":\"%s\",\"started_at\":\"%s\"}' \"${TOOL_INPUT_subagent_type:-agent}\" \"$(printf '%s' \"${TOOL_INPUT_prompt:-}\" | head -c 80 | tr '\"' \"'\")\" \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" > ~/.agentics/agents/${HASH}.json; if [ -f ~/.agentics/session.json ]; then TMP=$(mktemp) && jq '.agents_spawned += 1' ~/.agentics/session.json > \"$TMP\" 2>/dev/null && mv \"$TMP\" ~/.agentics/session.json; fi",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "[ -d node_modules/claude-flow ] && [ -n \"$TOOL_INPUT_prompt\" ] && npx @claude-flow/cli@latest hooks pre-task --task-id \"task-$(date +%s)\" --description \"$TOOL_INPUT_prompt\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d node_modules/claude-flow ] && [ -n \"$TOOL_INPUT_file_path\" ] && npx @claude-flow/cli@latest hooks post-edit --file \"$TOOL_INPUT_file_path\" --success \"${TOOL_SUCCESS:-true}\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d node_modules/claude-flow ] && [ -n \"$TOOL_INPUT_command\" ] && npx @claude-flow/cli@latest hooks post-command --command \"$TOOL_INPUT_command\" --success \"${TOOL_SUCCESS:-true}\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      },
      {
        "matcher": "^Task$",
        "hooks": [
          {
            "type": "command",
            "command": "HASH=$(printf '%s' \"${TOOL_INPUT_prompt:-noid}\" | cksum | cut -d' ' -f1) && rm -f ~/.agentics/agents/${HASH}.json",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "[ -d node_modules/claude-flow ] && [ -n \"$TOOL_RESULT_agent_id\" ] && npx @claude-flow/cli@latest hooks post-task --task-id \"$TOOL_RESULT_agent_id\" --success \"${TOOL_SUCCESS:-true}\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f ~/.agentics/session.json ]; then TMP=$(mktemp) && jq '.prompts += 1' ~/.agentics/session.json > \"$TMP\" 2>/dev/null && mv \"$TMP\" ~/.agentics/session.json; fi; [ -d node_modules/claude-flow ] && [ -n \"$PROMPT\" ] && npx @claude-flow/cli@latest hooks route --task \"$PROMPT\" 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.agentics/agents ~/.agentics/calls && rm -f ~/.agentics/agents/*.json ~/.agentics/calls/*.json && printf '{\"started_at\":\"%s\",\"edits\":0,\"commands\":0,\"prompts\":0,\"agents_spawned\":0}' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" > ~/.agentics/session.json",
            "timeout": 2000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "[ -d node_modules/claude-flow ] && npx @claude-flow/cli@latest daemon start --quiet 2>/dev/null || true",
            "timeout": 5000,
            "continueOnError": true
          },
          {
            "type": "command",
            "command": "[ -d node_modules/claude-flow ] && [ -n \"$SESSION_ID\" ] && npx @claude-flow/cli@latest hooks session-restore --session-id \"$SESSION_ID\" 2>/dev/null || true",
            "timeout": 10000,
            "continueOnError": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f ~/.agentics/agents/*.json ~/.agentics/calls/*.json ~/.agentics/session.json 2>/dev/null; echo '{\"ok\": true}'",
            "timeout": 1000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d node_modules/claude-flow ] && [ -n \"$NOTIFICATION_MESSAGE\" ] && npx @claude-flow/cli@latest memory store --namespace notifications --key \"notify-$(date +%s)\" --value \"$NOTIFICATION_MESSAGE\" 2>/dev/null || true",
            "timeout": 3000,
            "continueOnError": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "agentics statusline 2>/dev/null || npx @llm-dev-ops/agentics-cli statusline 2>/dev/null || echo '◇ Agentics.dev'",
    "refreshMs": 5000,
    "enabled": true
  },
  "permissions": {
    "allow": [
      "Bash(npx claude-flow:*)",
      "Bash(npx @claude-flow/cli:*)",
      "mcp__claude-flow__:*",
      "mcp__agentics-cli__:*",
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)"
    ],
    "deny": []
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  }
}